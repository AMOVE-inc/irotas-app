{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_BUILD_PROFILE": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://app.irotas-community.com",
        "EXPO_PUBLIC_APP_SCHEME": "iroplus",
        "EXPO_PUBLIC_BUNDLE_IDENTIFIER": "com.irotas.community"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      },
      "ios": {
        "ascAppId": "6814470868"
      }
    }
  }
}
