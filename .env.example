# Public Expo configuration (bundled into the client; never put secrets here)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_APP_SCHEME=iroplus
EXPO_PUBLIC_BUNDLE_IDENTIFIER=com.irotas.community
# Local preview only. Never enable this in a production build.
EXPO_PUBLIC_PREVIEW_LOGIN_ENABLED=false
# Share previews should use "user". Local admin QA may use "admin".
EXPO_PUBLIC_PREVIEW_USER_ROLE=user

# Optional Manus OAuth compatibility. Leave blank when email/password auth is used.
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OWNER_OPEN_ID=
EXPO_PUBLIC_OWNER_NAME=

# Server-only configuration
APP_ENVIRONMENT=development
DATABASE_URL=mysql://user:password@localhost:3306/irotas
JWT_SECRET=replace-with-a-long-random-secret
# Sites本番認証用。32バイト以上のランダム値を秘密情報として登録する。
AUTH_SECRET=replace-with-at-least-32-random-bytes
# 初回管理者だけを安全に登録するためのメールアドレス。本番では秘密情報として保存する。
BOOTSTRAP_ADMIN_EMAIL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
OWNER_EMAIL=
OPENAI_API_KEY=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Deferred external integrations
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Google Mapsで公開したグルメ保存リストの共有URL
EXPO_PUBLIC_GOOGLE_GOURMET_MAP_URL=

# Google Apps ScriptのグルメマップJSONフィードURL（Sitesの本番環境変数として設定）
GOURMET_MAP_FEED_URL=

# サーバー側のPlaces APIキー（ごちそうさま報告の店舗照合・情報補完）
GOOGLE_MAPS_API_KEY=
# Google店舗写真の緊急停止と月間ハード上限（初期値5000回）
GOOGLE_MAPS_PHOTOS_ENABLED=true
GOOGLE_MAPS_PHOTO_MONTHLY_LIMIT=5000
# Text Search Enterpriseの無料枠内に収める月間上限
GOOGLE_MAPS_SEARCH_MONTHLY_LIMIT=1000
# 未設定なら運営承認。将来「1」にすると星4以上の候補を1件から自動公開する。
GOURMET_MAP_AUTO_PUBLISH_MIN_REPORTERS=
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
EVENT_PAYMENTS_ENABLED=false
EXPO_PUBLIC_EVENT_PAYMENTS_ENABLED=false
# IRO+会費に該当するSquareプランバリエーションID（複数はカンマ区切り）
SQUARE_ALLOWED_PLAN_VARIATION_IDS=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://example.com/api/webhooks/square
# メール配信サービスまたは自動化基盤の受信用Webhook（POST JSON: to, subject, text）
EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_DELIVERY_WEBHOOK_TOKEN=
# 推奨: Resendを直接利用する場合（Webhook方式とのどちらか一方で可）
RESEND_API_KEY=
AUTH_EMAIL_FROM="IRO+ <app@updates.irotas-community.com>"
SENTRY_DSN=
